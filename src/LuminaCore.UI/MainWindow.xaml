<Window x:Class="LuminaCore.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        Title="LuminaCore"
        Width="1260"
        Height="740"
        MinWidth="1060"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="#08090D">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      CornerRadius="12"
                      GlassFrameThickness="1"
                      ResizeBorderThickness="6"
                      UseAeroCaptionButtons="False"/>
    </WindowChrome.WindowChrome>

    <Grid Background="#08090D">
        <!-- System Tray Icon -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                        ToolTipText="LuminaCore — Ctrl+Alt+L"
                        TrayMouseDoubleClick="TrayIcon_OnDoubleClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open LuminaCore" Click="TrayOpen_Click"/>
                    <MenuItem Header="Toggle Lights (Ctrl+Alt+L)" Command="{Binding ToggleBlackoutCommand}"/>
                    <Separator/>
                    <MenuItem Header="Exit" Click="TrayExit_Click"/>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>

        <!-- Embedded Edge WebView2 Commercial-Grade Frontend -->
        <wv2:WebView2 x:Name="WebView"
                      DefaultBackgroundColor="#FF08090D"/>
    </Grid>
</Window>
